# ============================================================================
# 测试环境变量样例：复制为 deploy/.env.test 后填写（该文件已被 .gitignore 忽略）
# ============================================================================
# 生成方式：openssl rand -hex 12 / openssl rand -base64 32
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
TAG_PLATFORM_MASTER_KEY=

# StarRocks all-in-one 默认 root 空密码
STARROCKS_USER=root
STARROCKS_PASSWORD=
STARROCKS_IMAGE=starrocks/allin1-ubuntu:3.2.6

# 宿主机端口（仅绑定 127.0.0.1）
MYSQL_PORT=3306
REDIS_PORT=6379
STARROCKS_FE_PORT=9030
STARROCKS_HTTP_PORT=8030

# 应用端口（systemd 启动参数）
TAG_PLATFORM_PORT=8081
