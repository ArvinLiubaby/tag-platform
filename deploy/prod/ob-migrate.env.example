# ============================================================================
# 生产环境迁移连接样例（仅 apply-oceanbase-migrations.sh 使用）
#
# 部署：
#   cp ob-migrate.env.example /etc/tag-platform/ob-migrate.env
#   chown root:root /etc/tag-platform/ob-migrate.env
#   chmod 600 /etc/tag-platform/ob-migrate.env
#
# 与 tag-platform.env 分离的原因：迁移使用 DDL 权限账号，运行账号权限更小。
# ============================================================================

OB_HOSTS="ob-node-1 ob-node-2 ob-node-3"
OB_PORT=2883
OB_USER="root@tagprofile"
OB_PASSWORD=CHANGE_ME
