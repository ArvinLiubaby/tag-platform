# ============================================================================
# 生产环境应用环境变量样例（systemd tag-platform 使用）
#
# 部署：
#   cp tag-platform.env.example /etc/tag-platform/tag-platform.env
#   chown root:tagplatform /etc/tag-platform/tag-platform.env
#   chmod 640 /etc/tag-platform/tag-platform.env
#
# 注意：
#   - 所有 CHANGE_ME 必须替换为真实值，口令/主密钥只留在部署机，不入库
#   - OceanBase 不支持 Flyway 命名锁，迁移预执行后保持 SPRING_FLYWAY_ENABLED=false
#     迁移连接参数见 ob-migrate.env.example，执行方式见 README 6.1
# ============================================================================

SERVER_PORT=8080

# 元数据库：OceanBase 3 节点（OBProxy 端口 2883）
SPRING_DATASOURCE_URL="jdbc:mysql://ob-node-1:2883,ob-node-2:2883,ob-node-3:2883/tag_platform?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&connectTimeout=5000&socketTimeout=30000&failOverReadOnly=false&maxReconnects=3&initialTimeout=2"
SPRING_DATASOURCE_USERNAME="root@tagprofile"
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# 连接池（生产按负载调整；单实例 2C4G 起步可用默认）
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=10000

# Redis：本机实例
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_TIMEOUT=2s

# 存储实现：redis + starrocks（生产形态）
TAG_PLATFORM_KV=redis
TAG_PLATFORM_STORE=starrocks

# StarRocks 集群（FE 查询端口 9030）
TAG_PLATFORM_STARROCKS_URL="jdbc:mysql://starrocks-host:9030/tag_platform?useSSL=false&serverTimezone=Asia/Shanghai&connectTimeout=5000&socketTimeout=30000"
TAG_PLATFORM_STARROCKS_USERNAME="tag_user"
TAG_PLATFORM_STARROCKS_PASSWORD=CHANGE_ME
TAG_PLATFORM_STARROCKS_INIT_SCHEMA=true

# 凭证 Secret 加密主密钥（openssl rand -base64 32 生成；与测试环境必须不同）
TAG_PLATFORM_CRYPTO_MASTER_KEY=CHANGE_ME

# 健康检查与日志
MANAGEMENT_HEALTH_REDIS_ENABLED=true
LOGGING_LEVEL_COM_TAGPLATFORM=INFO

# OceanBase 环境必须关闭 Flyway（见 README 6.1 预执行迁移）
SPRING_FLYWAY_ENABLED=false
