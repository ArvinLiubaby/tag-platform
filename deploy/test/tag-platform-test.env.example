# ============================================================================
# 测试环境应用环境变量样例（systemd tag-platform-test 使用）
#
# 部署：
#   cp tag-platform-test.env.example /etc/tag-platform-test/tag-platform-test.env
#   chown root:tagplatform /etc/tag-platform-test/tag-platform-test.env
#   chmod 640 /etc/tag-platform-test/tag-platform-test.env
#
# 两套变量互不替代：
#   - 本文件：应用进程连接参数（systemd EnvironmentFile）
#   - /opt/tag-platform-test/.env.test：docker compose 变量（容器口令、镜像、端口）
# ============================================================================

SERVER_PORT=8081

# 元数据库（容器 tp-test-mysql，仅监听 127.0.0.1）
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/tag_platform?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=tag_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# Redis（容器 tp-test-redis）
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379

# StarRocks（容器 tp-test-starrocks；首次需手工建库，见 README 6.2）
TAG_PLATFORM_STARROCKS_URL=jdbc:mysql://127.0.0.1:9030/tag_platform?useSSL=false&serverTimezone=Asia/Shanghai
TAG_PLATFORM_STARROCKS_USERNAME=root
TAG_PLATFORM_STARROCKS_PASSWORD=CHANGE_ME
TAG_PLATFORM_STARROCKS_INIT_SCHEMA=true

# 凭证 Secret 加密主密钥（openssl rand -base64 32 生成；各环境独立，不可复用）
TAG_PLATFORM_CRYPTO_MASTER_KEY=CHANGE_ME

# 容器化 MySQL 支持 Flyway 命名锁，可开启自动迁移
SPRING_FLYWAY_ENABLED=true
LOGGING_LEVEL_COM_TAGPLATFORM=INFO
