# ============================================================================
# 部署环境变量样例：cp .env.example .env 后按需修改（docker compose 自动加载）
# ============================================================================

# 凭证 Secret 可逆加密主密钥：生产必须替换为强随机值（openssl rand -base64 32）
TAG_PLATFORM_MASTER_KEY=please-change-me-in-production-0123456789

# MySQL（元数据库）：root 口令与应用账号口令
MYSQL_ROOT_PASSWORD=tp_root_demo
MYSQL_PASSWORD=tag_app_demo

# StarRocks：all-in-one 默认 root 空密码；生产集群按实调整
STARROCKS_USER=root
STARROCKS_PASSWORD=
STARROCKS_IMAGE=starrocks/allin1-ubuntu:3.2.6

# 端口映射（宿主机）
NGINX_PORT=80
TAG_PLATFORM_PORT=18080
MYSQL_PORT=3306
REDIS_PORT=6379
STARROCKS_FE_PORT=9030
STARROCKS_HTTP_PORT=8030
